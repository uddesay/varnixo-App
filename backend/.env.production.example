# Copy to backend/.env on the deployment host; never commit real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=5373
SERVE_WEB=true
API_BASE_URL=https://shop.example.com
# https://localhost is the Varnixo Android/iOS app (Capacitor) origin.
CORS_ORIGINS=https://shop.example.com,https://localhost
# Enable only with a trusted loopback reverse proxy that overwrites forwarded headers.
TRUST_PROXY=loopback
RATE_LIMIT_STORE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=varnixo
DB_USER=varnixo_app
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
LOG_LEVEL=info
# OTP delivery currently returns 503 in production until a real provider is implemented.
# Configure storage, online payments and couriers from .env.example as needed.
