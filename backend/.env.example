# Varnixo backend environment.
# `npm run demo:setup` generates backend/.env from this file with random secrets.
# Never commit the generated .env.
# Server
NODE_ENV=development
PORT=4200
API_BASE_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:5373,http://127.0.0.1:5373,https://localhost

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=varnixo_dev
DB_USER=varnixo_app
DB_PASSWORD=change_me
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# JWT (generate strong random values for production: openssl rand -hex 64)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Field-level encryption for sensitive data at rest (bank account numbers).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# OTP / SMS / Email
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@demo.varnixo.com

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=varnixo-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Shipping
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_KEY=
BLUEDART_API_KEY=
BLUEDART_LICENSE_KEY=
SHIPPING_WEBHOOK_SECRET=change_me_shipping_webhook_secret

# Firebase (push)
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Client demo (local only) -------------------------------------------
# Generated by `npm run demo:setup`; used only by the demo seeds.
DEMO_ADMIN_EMAIL=admin@demo.varnixo.com
DEMO_ADMIN_PASSWORD=
DEMO_SELLER_EMAIL=seller@demo.varnixo.com
DEMO_SELLER_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
