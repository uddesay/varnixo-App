# Copy to .env.local for local development. Never commit the real file.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Socket.IO gateway origin (no path suffix — the client appends /socket.io).
# Defaults to VITE_API_BASE_URL with any /api/... suffix stripped.
VITE_SOCKET_URL=http://localhost:4000
